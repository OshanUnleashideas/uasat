generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model customers {
  id         Int          @id @default(autoincrement())
  name       String
  phone      String?
  email      String?
  address    String?
  vehicles   vehicles[]
  quotations quotations[]
  created_at DateTime     @default(now())
  bills      bills[]
}

model expenses {
  id          Int       @id @default(autoincrement())
  category    String?   @db.VarChar(100)
  description String?   @db.Text
  amount      Decimal   @db.Decimal(10, 2)
  date        DateTime? @default(dbgenerated("(curdate())")) @db.Date
}

model income {
  id          Int       @id @default(autoincrement())
  bill_id     Int?
  description String?   @db.VarChar(255)
  amount      Decimal   @db.Decimal(10, 2)
  date        DateTime? @default(dbgenerated("(curdate())")) @db.Date
  bills       bills?    @relation(fields: [bill_id], references: [id], onUpdate: NoAction)

  @@index([bill_id], map: "bill_id")
}

model job_images {
  id         Int              @id @default(autoincrement())
  job_id     Int?
  image_path String?          @db.VarChar(255)
  type       job_images_type? @default(Before)
  jobs       jobs?            @relation(fields: [job_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([job_id], map: "job_id")
}

model jobs {
  id           Int          @id @default(autoincrement())
  quotation_id Int?
  technician   String?      @db.VarChar(100)
  status       jobs_status? @default(Pending)
  start_date   DateTime?    @db.Date
  end_date     DateTime?    @db.Date
  remarks      String?      @db.Text

  // ✅ link back to quotations
  quotation quotations? @relation("QuotationJobs", fields: [quotation_id], references: [id], onUpdate: NoAction)

  job_images job_images[]

  @@index([quotation_id], map: "quotation_id")
}

model bills {
  id             Int                   @id @default(autoincrement())
  quotation_id   Int?
  bill_no        String?               @unique(map: "bill_no") @db.VarChar(50)
  bill_date      DateTime?             @default(dbgenerated("(curdate())")) @db.Date
  subtotal       Decimal?              @db.Decimal(10, 2)
  vat            Decimal?              @default(0.00) @db.Decimal(10, 2)
  service_charge Decimal?              @default(0.00) @db.Decimal(10, 2)
  paid_amount   Decimal? @default(0.00) @db.Decimal(10, 2)
  balance_amount Decimal? @default(0.00) @db.Decimal(10, 2)
  total_amount   Decimal?              @db.Decimal(10, 2)
  payment_status bills_payment_status? @default(Unpaid)
  customerId     Int
  vehicleId      Int

  // ✅ proper relation name and opposite side
  customer  customers   @relation(fields: [customerId], references: [id])
  vehicle   vehicles    @relation(fields: [vehicleId], references: [id])
  quotation quotations? @relation("QuotationBills", fields: [quotation_id], references: [id], onUpdate: NoAction)

  income income[]

  @@index([quotation_id], map: "quotation_id")
}

model quotations {
  id              Int       @id @default(autoincrement())
  quotationNumber String    @unique @db.VarChar(50)
  customerId      Int
  vehicleId       Int
  jobType         String    @default("Normal Painting")
  validUntil      DateTime?
  taxRate         Decimal?  @default(0.00) @db.Decimal(5, 2)
  total           Decimal?  @default(0.00) @db.Decimal(10, 2)
  status          String    @default("Pending")
  createdAt       DateTime  @default(now())

  // ✅ proper relations
  customer customers         @relation(fields: [customerId], references: [id])
  vehicle  vehicles          @relation(fields: [vehicleId], references: [id])
  items    quotation_items[]

  // ✅ new opposite sides for existing relations
  bills bills[] @relation("QuotationBills")
  jobs  jobs[]  @relation("QuotationJobs")
}

model quotation_items {
  id          Int     @id @default(autoincrement())
  quotationId Int
  description String
  quantity    Decimal @db.Decimal(10, 2)
  unitPrice   Decimal @db.Decimal(10, 2)
  total       Decimal @db.Decimal(10, 2)

  quotation quotations @relation(fields: [quotationId], references: [id])
}

model users {
  id         Int         @id @default(autoincrement())
  name       String      @db.VarChar(100)
  email      String      @unique(map: "email") @db.VarChar(100)
  password   String      @db.VarChar(255)
  role       users_role? @default(Staff)
  created_at DateTime?   @default(now()) @db.Timestamp(0)
}

model vehicles {
  id          Int            @id @default(autoincrement())
  customer_id Int?
  vehicle_no  String         @db.VarChar(20)
  brand       String?        @db.VarChar(50)
  model       String?        @db.VarChar(50)
  color       String?        @db.VarChar(30)
  year        Int?           @db.Year
  type        vehicles_type? @default(Car)
  quotations  quotations[]
  customers   customers?     @relation(fields: [customer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  bills       bills[]

  @@index([customer_id], map: "customer_id")
}

enum job_images_type {
  Before
  After
}

enum jobs_status {
  Pending
  In_Progress @map("In Progress")
  Completed
}

enum quotations_job_type {
  Accident_Repair @map("Accident Repair")
  Normal_Painting @map("Normal Painting")
  Custom_Work     @map("Custom Work")
}

enum users_role {
  Admin
  Staff
}

enum vehicles_type {
  Car
  Van
  Truck
  Bike
  Other
}

enum bills_payment_status {
  Paid
  Unpaid
  Pending
}

enum quotations_status {
  Pending
  Approved
  Rejected
}
